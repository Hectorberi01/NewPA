pm2 start ecosystem.config.js --env production
pm2 status
pm2 logs myapp --lines 100

sudo tee /etc/systemd/system/newpa.service >/dev/null <<'EOF'
[Unit]
Description=NewPA API (Node.js)
After=network.target

[Service]
WorkingDirectory=/srv/newpa
ExecStart=/usr/bin/node dist/server.js
Environment=NODE_ENV=production
Environment=PORT=3000
# ajoute ici tes variables (DB_URL, JWT_SECRET, GOOGLE_CLIENT_ID, etc.)
Restart=always
User=www-data
Group=www-data

[Install]
WantedBy=multi-user.target
EOF

sudo systemctl daemon-reload
sudo systemctl enable --now newpa
sudo systemctl status newpa --no-pager -l
